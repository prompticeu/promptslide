{
  "name": "promptslide",
  "version": "0.3.22",
  "description": "CLI and slide engine for PromptSlide presentations",
  "keywords": [
    "cli",
    "presentations",
    "promptslide",
    "react",
    "slides",
    "vite"
  ],
  "license": "MIT",
  "author": "prompticeu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prompticeu/promptslide.git"
  },
  "bin": {
    "promptslide": "src/index.mjs"
  },
  "files": [
    "src/",
    "dist/",
    "templates/",
    "CHANGELOG.md",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./src/commands/*": "./src/commands/*",
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./pdf-browser": {
      "types": "./dist/pdf-browser.d.ts",
      "import": "./dist/pdf-browser.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@vitejs/plugin-react": "^4.5.2",
    "@xmldom/xmldom": "0.9.12",
    "buffer": "6.0.3",
    "clsx": "^2.1.1",
    "fflate": "0.8.2",
    "harfbuzzjs": "1.6.4",
    "jszip": "3.10.1",
    "lucide-react": "^0.552.0",
    "path-browserify": "1.0.1",
    "pdf-lib": "1.17.1",
    "playwright": "^1.50.0",
    "postcss": "^8.5.6",
    "pptxgenjs": "4.0.1",
    "subset-font": "2.9.0",
    "svgpath": "2.6.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.3",
    "vite": "^6.3.5",
    "wawoff2": "2.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "tsup": "^8.5.1"
  },
  "peerDependencies": {
    "framer-motion": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
